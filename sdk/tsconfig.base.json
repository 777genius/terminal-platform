{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@terminal-platform/foundation": [
        "packages/foundation/src/index.ts"
      ],
      "@terminal-platform/runtime-types": [
        "packages/runtime-types/src/index.ts"
      ],
      "@terminal-platform/design-tokens": [
        "packages/design-tokens/src/index.ts"
      ],
      "@terminal-platform/design-tokens/css": [
        "packages/design-tokens/src/css.ts"
      ],
      "@terminal-platform/design-tokens/themes": [
        "packages/design-tokens/src/themes.ts"
      ],
      "@terminal-platform/workspace-contracts": [
        "packages/workspace-contracts/src/index.ts"
      ],
      "@terminal-platform/workspace-contracts/commands": [
        "packages/workspace-contracts/src/commands.ts"
      ],
      "@terminal-platform/workspace-contracts/errors": [
        "packages/workspace-contracts/src/errors.ts"
      ],
      "@terminal-platform/workspace-contracts/observations": [
        "packages/workspace-contracts/src/observations.ts"
      ],
      "@terminal-platform/workspace-contracts/ports": [
        "packages/workspace-contracts/src/ports.ts"
      ],
      "@terminal-platform/workspace-core": [
        "packages/workspace-core/src/index.ts"
      ],
      "@terminal-platform/workspace-core/bootstrap": [
        "packages/workspace-core/src/bootstrap.ts"
      ],
      "@terminal-platform/workspace-core/testing": [
        "packages/workspace-core/src/testing.ts"
      ],
      "@terminal-platform/workspace-adapter-websocket": [
        "packages/workspace-adapter-websocket/src/index.ts"
      ],
      "@terminal-platform/workspace-adapter-websocket/protocol": [
        "packages/workspace-adapter-websocket/src/protocol.ts"
      ],
      "@terminal-platform/workspace-gateway-node": [
        "packages/workspace-gateway-node/src/index.ts"
      ],
      "@terminal-platform/workspace-adapter-preload": [
        "packages/workspace-adapter-preload/src/index.ts"
      ],
      "@terminal-platform/workspace-adapter-memory": [
        "packages/workspace-adapter-memory/src/index.ts"
      ],
      "@terminal-platform/workspace-elements": [
        "packages/workspace-elements/src/index.ts"
      ],
      "@terminal-platform/workspace-elements/define": [
        "packages/workspace-elements/src/define.ts"
      ],
      "@terminal-platform/workspace-elements/styles": [
        "packages/workspace-elements/src/styles.ts"
      ],
      "@terminal-platform/workspace-react": [
        "packages/workspace-react/src/index.ts"
      ],
      "@terminal-platform/testing": [
        "packages/testing/src/index.ts"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  }
}
