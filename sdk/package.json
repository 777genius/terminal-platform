{
  "name": "terminal-platform-sdk-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/foundation",
    "packages/runtime-types",
    "packages/design-tokens",
    "packages/workspace-contracts",
    "packages/workspace-core",
    "packages/workspace-adapter-websocket",
    "packages/workspace-gateway-node",
    "packages/workspace-adapter-preload",
    "packages/workspace-adapter-memory",
    "packages/workspace-elements",
    "packages/workspace-react",
    "packages/testing"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:public-api": "vitest run packages/design-tokens/src/public-entrypoints.test.ts packages/workspace-contracts/src/public-entrypoints.test.ts packages/workspace-core/src/bootstrap.test.ts packages/workspace-core/src/testing.test.ts packages/workspace-adapter-websocket/src/public-entrypoints.test.ts packages/workspace-gateway-node/src/index.test.ts packages/workspace-elements/src/define.test.ts packages/workspace-elements/src/index.test.ts packages/workspace-elements/src/styles.test.ts packages/workspace-elements/src/elements/terminal-command-composer-actions.test.ts packages/workspace-elements/src/elements/terminal-command-composer-layout.test.ts packages/workspace-elements/src/elements/terminal-command-dock-accessories.test.ts packages/workspace-elements/src/elements/terminal-command-dock-controls.test.ts packages/workspace-elements/src/elements/terminal-command-dock-session-actions.test.ts packages/workspace-elements/src/elements/terminal-screen-actions.test.ts packages/workspace-elements/src/elements/terminal-screen-chrome.test.ts packages/workspace-elements/src/elements/terminal-workspace-layout.test.ts packages/workspace-react/src/index.test.ts packages/testing/src/workspace-test-harness.test.ts packages/testing/src/packed-consumer-smoke.test.ts",
    "test:packed-consumer": "npm run build && node scripts/packed-consumer-smoke.mjs",
    "check:compatibility-matrix": "node scripts/check-compatibility-matrix.mjs",
    "check:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "check:examples": "node scripts/check-example-public-imports.mjs && tsc -p examples/tsconfig.json --noEmit",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check": "npm run check:compatibility-matrix && npm run check:performance-budgets && npm run check:examples && npm run check:release-readiness && npm run typecheck && npm run build && npm run test",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/node": "25.6.0",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "ws": "8.21.0"
  }
}
